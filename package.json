{
  "name": "kora-ui-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for the kora-ui component library, its sketch system, and its docs site.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w kora-ui",
    "build:lib": "npm run build -w kora-ui && npm run build -w kora-ui-mcp",
    "build:docs": "npm run build -w docs",
    "dev:lib": "npm run dev -w kora-ui",
    "dev:docs": "npm run dev -w docs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "version": "changeset version && npm install --package-lock-only",
    "release": "npm run build:lib && changeset publish",
    "check:tags": "node scripts/check-tags.mjs apps/docs/templates apps/docs/demos",
    "dev:sketch": "PORT=3461 npm start -w kora-ui-sketch"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3"
  }
}
