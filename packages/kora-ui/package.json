{
  "name": "kora-ui",
  "version": "1.0.0-next.1",
  "description": "React UI library for building admin and analytics dashboards: layout, data tables, charts, and ready-made screens.",
  "author": {
    "name": "Isaac Avila",
    "email": "isaacaldairavila@gmail.com",
    "url": "https://github.com/isaacavilap"
  },
  "license": "MIT",
  "homepage": "https://kora-ui.istmocode.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaacavilap/kora-ui.git"
  },
  "bugs": {
    "url": "https://github.com/isaacavilap/kora-ui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "component-library",
    "dashboard",
    "admin",
    "analytics",
    "data-table",
    "charts",
    "auth-screens"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./table": { "types": "./dist/table.d.ts", "import": "./dist/table.js" },
    "./charts": { "types": "./dist/charts.d.ts", "import": "./dist/charts.js" },
    "./auth": { "types": "./dist/auth.d.ts", "import": "./dist/auth.js" },
    "./screens": { "types": "./dist/screens.d.ts", "import": "./dist/screens.js" },
    "./styles.css": "./dist/styles.css",
    "./styles-layer.css": "./dist/styles-layer.css",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": ["**/*.css"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsup && npm run build:css",
    "build:css": "tailwindcss -i src/styles/index.css -o dist/styles.css --minify && cp src/styles/layer.css dist/styles-layer.css",
    "dev": "tsup --watch src --onSuccess \"npm run dev:sync\"",
    "dev:sync": "npm run build:css && node ../../scripts/sync-consumers.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@daypicker/react": "^10.0.2",
    "@tanstack/react-table": "^9.3.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.69.0",
    "qrcode-generator": "^2.0.4",
    "radix-ui": "^1.8.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^26.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.0"
  },
  "publishConfig": { "access": "public", "tag": "next" }
}
